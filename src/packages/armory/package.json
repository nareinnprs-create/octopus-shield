{
  "name": "@shield/armory",
  "version": "0.0.0",
  "private": true,
  "description": "Shield Armory: scope-authorized execution layer for integrated security tooling",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "shield-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tool-registry": {
      "shield-source": "./src/tool-registry.ts",
      "types": "./dist/tool-registry.d.ts",
      "default": "./dist/tool-registry.js"
    },
    "./tool-scope": {
      "shield-source": "./src/tool-scope.ts",
      "types": "./dist/tool-scope.d.ts",
      "default": "./dist/tool-scope.js"
    },
    "./tool-runner": {
      "shield-source": "./src/tool-runner.ts",
      "types": "./dist/tool-runner.d.ts",
      "default": "./dist/tool-runner.js"
    },
    "./armory-audit": {
      "shield-source": "./src/armory-audit.ts",
      "types": "./dist/armory-audit.d.ts",
      "default": "./dist/armory-audit.js"
    },
    "./inventory": {
      "shield-source": "./src/inventory.ts",
      "types": "./dist/inventory.d.ts",
      "default": "./dist/inventory.js"
    },
    "./armory-cli": {
      "shield-source": "./src/armory-cli.ts",
      "types": "./dist/armory-cli.d.ts",
      "default": "./dist/armory-cli.js"
    }
  },
  "scripts": {
    "build": "tsx --conditions=shield-source scripts/build-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@shield/access": "workspace:*",
    "@shield/audit-store": "workspace:*",
    "@shield/process-host": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "proper-lockfile": "4.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}
